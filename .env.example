# Discord (one bot per role)
DISCORD_TOKEN_SELLER=
DISCORD_TOKEN_BUYER=
BRIEFING_CHANNEL_SELLER_ID=
BRIEFING_CHANNEL_BUYER_ID=
NEGOTIATION_CHANNEL_ID=
# the other bot's user id (set per bot process)
OTHER_BOT_ID=

# zk = real SP1 proofs via target/release/zkn; native = check only (unproven)
ZKN_PROOFS=zk
# SP1 backend: cpu | cuda (cuda needs `cargo build --release -p zkn --features cuda`)
SP1_PROVER=cpu

# Local model (Ollama)
OLLAMA_HOST=http://localhost:11434
ZKN_MODEL=qwen3:8b
